<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolutionDeployer.App.ViewModels"
        x:Class="SolutionDeployer.App.Views.CredentialLibraryWindow"
        x:DataType="vm:CredentialLibraryViewModel"
        Title="Credentials"
        Width="700" Height="520" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app-icon.ico">

    <Window.Styles>
        <Style Selector="StackPanel.field">
            <Setter Property="Spacing" Value="4" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Saved credentials" Classes="heading" />
            <TextBlock Text="Usernames and passwords that several targets can share: pick one in a target's Credentials dialog. Passwords are kept in the OS credential store."
                       Classes="subheading" TextWrapping="Wrap" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Classes="footer">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Error}" Classes="problem" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Classes="buttons">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="210,*" ColumnSpacing="14">
            <!-- Entry list -->
            <DockPanel Grid.Column="0">
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,8,0,0">
                    <Button Grid.Column="0" Content="Add" Command="{Binding AddCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
                <Border Classes="card" Padding="2">
                    <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CredentialEntryEditViewModel">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- Selected entry -->
            <Border Grid.Column="1" Classes="card" Padding="14">
                <Panel>
                    <TextBlock Text="Add a credential to share it between targets." Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasSelection}" />
                    <ScrollViewer IsVisible="{Binding HasSelection}">
                        <StackPanel Spacing="12" Margin="0,0,10,0">
                            <Border Classes="card" Padding="10" Background="#22E05050" IsVisible="{Binding IsConfirmingDelete}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding DeleteWarning}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Button Content="Keep it" Command="{Binding KeepEntryCommand}" />
                                        <Button Content="Delete" Classes="danger" Command="{Binding ConfirmDeleteCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="12" DataContext="{Binding Selected}" x:DataType="vm:CredentialEntryEditViewModel">
                                <StackPanel Classes="field">
                                    <TextBlock Text="Name" Classes="label" />
                                    <TextBox Text="{Binding Name}" PlaceholderText="e.g. Prod IIS deploy user" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Classes="field">
                                        <TextBlock Text="Username" Classes="label" />
                                        <TextBox Text="{Binding UserName}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Classes="field">
                                        <TextBlock Text="Password" Classes="label" />
                                        <TextBox Text="{Binding Password}" PasswordChar="•" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Classes="field">
                                    <TextBlock Text="Notes (optional, not secret)" Classes="label" />
                                    <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                </StackPanel>
                                <TextBlock Text="{Binding UsageText}" Classes="hint" TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Text="No secure credential store on this computer: entries keep only the username, and targets ask for the password each session."
                                       Classes="hint" TextWrapping="Wrap" IsVisible="{Binding !CredentialStoreAvailable}" />
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
