<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolutionDeployer.App.ViewModels"
        x:Class="SolutionDeployer.App.Views.DeploySummaryWindow"
        x:DataType="vm:DeploySummaryViewModel"
        Title="Deployment summary"
        Width="560" Height="420" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app-icon.ico">

    <Window.Styles>
        <!-- Only the status marks are coloured; names and details stay readable. -->
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="#E05561" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.status.success">
            <Setter Property="Foreground" Value="#2EA043" />
        </Style>
        <Style Selector="TextBlock.detail">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.detail.failure">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="#E05561" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" Classes="heading" Margin="0,0,0,12" />

        <Border DockPanel.Dock="Bottom" Classes="footer">
            <StackPanel Classes="buttons">
                <Button Content="Close" Command="{Binding CloseCommand}" Classes="accent" IsDefault="True" IsCancel="True" />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Projects}" Margin="0,0,10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeploySummaryProject">
                            <StackPanel Margin="0,0,0,12" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="name" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                                               Classes="status" Classes.success="{Binding IsSuccess}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Targets}" Margin="12,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DeploySummaryTarget">
                                            <Grid ColumnDefinitions="18,Auto,*" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="✔" Classes="status success" IsVisible="{Binding IsSuccess}" />
                                                <TextBlock Grid.Column="0" Text="✘" Classes="status" IsVisible="{Binding !IsSuccess}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12"
                                                           Classes="detail" Classes.failure="{Binding !IsSuccess}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
