<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolutionDeployer.App.ViewModels"
        xmlns:services="clr-namespace:SolutionDeployer.App.Services"
        xmlns:config="clr-namespace:SolutionDeployer.Core.Configuration;assembly=SolutionDeployer.Core"
        x:Class="SolutionDeployer.App.Views.TargetCredentialsWindow"
        x:DataType="vm:TargetCredentialsViewModel"
        Title="{Binding Title}"
        Width="600" Height="640" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app-icon.ico">

    <Window.Styles>
        <Style Selector="StackPanel.field">
            <Setter Property="Spacing" Value="4" />
        </Style>
        <Style Selector="Border.card > StackPanel">
            <Setter Property="Spacing" Value="10" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14" Spacing="2">
            <TextBlock Text="{Binding Heading}" Classes="heading" />
            <TextBlock Text="{Binding Kind}" Classes="subheading" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Classes="footer">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="Test" Command="{Binding TestCommand}" IsVisible="{Binding CanTest}"
                        ToolTip.Tip="Check these credentials against the server without deploying" />
                <TextBlock Grid.Column="1" Text="{Binding Error}" Classes="problem" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0" />
                <StackPanel Grid.Column="2" Classes="buttons">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" IsDefault="True"
                            ToolTip.Tip="Save these credentials for this target now" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Spacing="12" Margin="0,0,12,0">
                <Border Classes="card" Padding="12" IsVisible="{Binding HasPrompt}" Background="#22E0A030">
                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" />
                </Border>

                <!-- Connection -->
                <Border Classes="card" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Connection" Classes="section" />
                        <ItemsControl ItemsSource="{Binding Connection}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:ConnectionDetail">
                                    <Grid ColumnDefinitions="130,*" Margin="0,0,0,4">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="label" />
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Credentials -->
                <Border Classes="card" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Sign in with" Classes="section" />

                        <RadioButton GroupName="source" Content="A saved credential from the library"
                                     IsChecked="{Binding UseLibrary}" />
                        <StackPanel Classes="field" Margin="28,0,0,0" IsVisible="{Binding UseLibrary}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedEntry}"
                                          HorizontalAlignment="Stretch" PlaceholderText="(no saved credentials yet)">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="config:SavedCredential">
                                            <TextBlock>
                                                <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding UserName}" Foreground="Gray" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="Manage…" Command="{Binding ManageLibraryCommand}"
                                        ToolTip.Tip="Add, rename, edit or delete saved credentials" />
                            </Grid>
                            <TextBlock Text="{Binding SelectedEntryInfo}" Classes="hint" TextWrapping="Wrap" />
                        </StackPanel>

                        <RadioButton GroupName="source" Content="This target's own username and password"
                                     IsChecked="{Binding UseOwn}" />
                        <StackPanel Spacing="10" Margin="28,0,0,0" IsVisible="{Binding UseOwn}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Classes="field">
                                    <TextBlock Text="Username" Classes="label" />
                                    <TextBox Text="{Binding UserName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="field">
                                    <TextBlock Text="Password" Classes="label" />
                                    <TextBox Text="{Binding Password}" PasswordChar="•" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Remember the password" IsChecked="{Binding RememberPassword}"
                                      IsEnabled="{Binding CredentialStoreAvailable}"
                                      ToolTip.Tip="Store it in the OS secure store (Credential Manager / Keychain / libsecret). Otherwise it is kept only until the app closes" />
                            <TextBlock Text="No secure credential store on this computer: the password is kept only until the app closes."
                                       Classes="hint" TextWrapping="Wrap"
                                       IsVisible="{Binding !CredentialStoreAvailable}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Test -->
                <Border Classes="card" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Test" Classes="section" />
                        <TextBlock Text="{Binding TestUnavailableReason}" Classes="hint" TextWrapping="Wrap"
                                   IsVisible="{Binding HasTestUnavailableReason}" />
                        <TextBlock Text="Test checks the credentials against the server without deploying anything."
                                   Classes="hint" TextWrapping="Wrap" IsVisible="{Binding CanTest}" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTesting}" />
                        <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontWeight="SemiBold"
                                   IsVisible="{Binding HasTestResult}" />
                        <Border Classes="card" Background="#0A000000" Padding="8" MaxHeight="180"
                                IsVisible="{Binding HasTestOutput}">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding TestOutput}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <SelectableTextBlock Text="{Binding}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
