<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolutionDeployer.App.ViewModels"
        x:Class="SolutionDeployer.App.Views.UpdateAvailableWindow"
        x:DataType="vm:UpdateAvailableViewModel"
        Title="Update available"
        Width="520" Height="440" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app-icon.ico">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding Heading}" Classes="heading" />
            <TextBlock Text="Here's what's new in this version." Classes="subheading" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Classes="footer">
            <StackPanel Classes="buttons">
                <Button Content="Later" Command="{Binding LaterCommand}" IsCancel="True" />
                <Button Content="Update now" Command="{Binding UpdateNowCommand}" Classes="accent" IsDefault="True" />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <ScrollViewer>
                <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap" Classes="mono" Margin="0,0,10,0" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
