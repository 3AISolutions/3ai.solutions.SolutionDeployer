<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolutionDeployer.App.ViewModels"
        x:Class="SolutionDeployer.App.Views.ScriptEditorWindow"
        x:DataType="vm:ScriptEditorViewModel"
        Title="{Binding Title}"
        Width="640" Height="760" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app-icon.ico">

    <Window.Styles>
        <Style Selector="StackPanel.field">
            <Setter Property="Spacing" Value="4" />
        </Style>
        <Style Selector="Border.card > StackPanel">
            <Setter Property="Spacing" Value="12" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Classes="heading" Margin="0,0,0,14" />

        <Border DockPanel.Dock="Bottom" Classes="footer">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Error}" Classes="problem" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Classes="buttons">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Spacing="12" Margin="0,0,12,0">

                <!-- Script -->
                <Border Classes="card" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Script" Classes="section" />
                        <StackPanel Classes="field">
                            <TextBlock Text="Name" Classes="label" />
                            <TextBox Text="{Binding Name}" PlaceholderText="e.g. Deploy to prod" />
                        </StackPanel>
                        <StackPanel Classes="field">
                            <TextBlock Text="Script file" Classes="label" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0" Text="{Binding ScriptPath}" PlaceholderText=".ps1 / .sh / .bash / .cmd / .bat" />
                                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Classes="field">
                            <TextBlock Text="Arguments" Classes="label" />
                            <TextBox Text="{Binding Arguments}" PlaceholderText="-Server host -ServiceName app.service" />
                            <TextBlock Text="Passed to the script. PowerShell named params bind directly; shells receive them positionally."
                                       Classes="hint" />
                        </StackPanel>
                        <StackPanel Classes="field">
                            <TextBlock Text="Working directory" Classes="label" />
                            <TextBox Text="{Binding WorkingDirectory}" PlaceholderText="(defaults to the project directory)" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Credentials -->
                <Border Classes="card" Padding="14">
                    <StackPanel>
                        <StackPanel Classes="field">
                            <CheckBox Content="Requires credentials" IsChecked="{Binding RequiresCredentials}" FontWeight="SemiBold" />
                            <TextBlock Text="Asks for a username and password on the script row (like a publish profile) and passes them to the script as these environment variables."
                                       Classes="hint" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding RequiresCredentials}">
                            <StackPanel Grid.Column="0" Classes="field">
                                <TextBlock Text="Username variable" Classes="label" />
                                <TextBox Text="{Binding UserNameVariable}" PlaceholderText="DEPLOY_USERNAME" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Classes="field">
                                <TextBlock Text="Password variable" Classes="label" />
                                <TextBox Text="{Binding PasswordVariable}" PlaceholderText="DEPLOY_PASSWORD" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Backup -->
                <Border Classes="card" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Backup" Classes="section" />
                        <StackPanel Classes="field">
                            <ComboBox ItemsSource="{Binding BackupKinds}" SelectedItem="{Binding SelectedBackupKind}" MinWidth="260" />
                            <TextBlock Text="{Binding BackupDescription}" Classes="hint" IsVisible="{Binding HasBackup}" />
                        </StackPanel>
                        <StackPanel Classes="field" IsVisible="{Binding IsWebDeployBackup}">
                            <TextBlock Text="Server" Classes="label" />
                            <TextBox Text="{Binding BackupServerUrl}" PlaceholderText="https://host:8172/msdeploy.axd" />
                        </StackPanel>
                        <StackPanel Classes="field" IsVisible="{Binding NeedsBackupFolder}">
                            <TextBlock Text="Folder" Classes="label" />
                            <TextBox Text="{Binding BackupPath}" PlaceholderText="D:\Hosted_Projects\MyApp  (or an IIS site name)" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding UsesServer}">
                            <StackPanel Grid.Column="0" Classes="field">
                                <TextBlock Text="Before restore" Classes="label" />
                                <TextBox Text="{Binding PreRestoreCommand}" PlaceholderText="e.g. net stop MyService" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Classes="field">
                                <TextBlock Text="After restore" Classes="label" />
                                <TextBox Text="{Binding PostRestoreCommand}" PlaceholderText="e.g. net start MyService" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Restore commands are optional and run on the server. Web Deploy uses the script's username and password (tick &quot;Requires credentials&quot;)."
                                   Classes="hint" IsVisible="{Binding UsesServer}" />
                    </StackPanel>
                </Border>

                <!-- Environment variables -->
                <Border Classes="card" Padding="14">
                    <StackPanel>
                        <StackPanel Classes="field">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Environment variables" Classes="section" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="small" Content="+ Add" Command="{Binding AddEnvVarCommand}" />
                            </Grid>
                            <TextBlock Text="SD_PROJECT_PATH, SD_PROJECT_DIR, SD_PROJECT_NAME and SD_CONFIGURATION are always provided."
                                       Classes="hint" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding EnvVars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EnvVarRow">
                                    <Grid ColumnDefinitions="*,2*,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                                        <TextBox Grid.Column="0" Text="{Binding Key}" PlaceholderText="KEY" Classes="mono" />
                                        <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="value" />
                                        <Button Grid.Column="2" Classes="ghost" Content="✕" ToolTip.Tip="Remove this variable"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[Window].((vm:ScriptEditorViewModel)DataContext).RemoveEnvVarCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
