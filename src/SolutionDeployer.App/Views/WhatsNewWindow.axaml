<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolutionDeployer.App.ViewModels"
        x:Class="SolutionDeployer.App.Views.WhatsNewWindow"
        x:DataType="vm:WhatsNewViewModel"
        Title="What's new"
        Width="560" Height="480" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app-icon.ico">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding Heading}" Classes="heading" />
            <!-- Also opened on demand from the toolbar, so don't claim an update just happened. -->
            <TextBlock Text="Release notes for the installed version." Classes="subheading" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Classes="footer">
            <StackPanel Classes="buttons">
                <Button Content="Close" Command="{Binding CloseCommand}" Classes="accent" IsDefault="True" IsCancel="True" />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <ScrollViewer>
                <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap" Classes="mono" Margin="0,0,10,0" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
