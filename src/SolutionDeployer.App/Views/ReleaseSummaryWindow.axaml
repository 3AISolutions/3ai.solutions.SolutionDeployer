<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolutionDeployer.App.ViewModels"
        xmlns:git="clr-namespace:SolutionDeployer.Core.Git;assembly=SolutionDeployer.Core"
        x:Class="SolutionDeployer.App.Views.ReleaseSummaryWindow"
        x:DataType="vm:ReleaseSummaryViewModel"
        Title="{Binding Title}"
        Width="680" Height="560" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app-icon.ico">

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Classes="heading" Margin="0,0,0,12" />

        <Border DockPanel.Dock="Bottom" Classes="footer">
            <StackPanel Classes="buttons">
                <Button Name="CopyButton" Content="Copy"
                        ToolTip.Tip="Copy the summary as text" Click="OnCopyClick" />
                <Button Content="Close" Command="{Binding CloseCommand}" Classes="accent" IsDefault="True" IsCancel="True" />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Projects}" Margin="0,0,10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="git:ProjectHistory">
                            <StackPanel Margin="0,0,0,14" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="pill" Background="#332888FF" IsVisible="{Binding IsRoot}">
                                        <TextBlock Text="deployed" />
                                    </Border>
                                    <TextBlock Text="{Binding ProjectName}" Classes="name" />
                                    <TextBlock Text="{Binding Branch, StringFormat='[{0}]'}" Classes="meta" />
                                    <TextBlock Text="● uncommitted changes" Foreground="#E0A044" FontSize="11"
                                               VerticalAlignment="Center" IsVisible="{Binding IsDirty}" />
                                </StackPanel>

                                <TextBlock Text="{Binding Note}" Classes="hint"
                                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                <ItemsControl ItemsSource="{Binding Commits}" Margin="4,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="git:CommitInfo">
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding ShortSha}" Classes="mono" FontSize="11"
                                                           Opacity="0.6" Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap">
                                                    <Run Text="{Binding Subject}" /><Run Text="  " /><Run Text="{Binding Author}" Foreground="#888" /><Run Text=", " Foreground="#888" /><Run Text="{Binding Date}" Foreground="#888" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
