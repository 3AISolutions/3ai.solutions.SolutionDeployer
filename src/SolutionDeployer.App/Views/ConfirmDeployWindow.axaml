<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolutionDeployer.App.ViewModels"
        x:Class="SolutionDeployer.App.Views.ConfirmDeployWindow"
        x:DataType="vm:ConfirmDeployViewModel"
        Title="Confirm deployment"
        Width="520" Height="420" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app-icon.ico">

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" Classes="heading" Margin="0,0,0,12" />

        <Border DockPanel.Dock="Bottom" Classes="footer">
            <Grid ColumnDefinitions="*,Auto">
                <CheckBox Grid.Column="0" Content="Don't ask again" IsChecked="{Binding DontAskAgain}" VerticalAlignment="Center"
                          ToolTip.Tip="Turns off deploy confirmation (re-enable it under Options)" />
                <StackPanel Grid.Column="1" Classes="buttons">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Content="Deploy" Command="{Binding ConfirmCommand}" Classes="accent" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Classes="card">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Targets}" Margin="0,0,10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Margin="0,3" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
