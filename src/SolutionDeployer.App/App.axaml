<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SolutionDeployer.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <!-- Toolbar / menu icons (24×24 grid, filled; drawn with the control's Foreground, so they follow the theme). -->
        <StreamGeometry x:Key="IconAddSolution">F1 M2,6 A2,2 0 0 1 4,4 H9 L11,6 H20 A2,2 0 0 1 22,8 V18 A2,2 0 0 1 20,20 H4 A2,2 0 0 1 2,18 Z M11,9.5 H13 V12 H15.5 V14 H13 V16.5 H11 V14 H8.5 V12 H11 Z</StreamGeometry>
        <StreamGeometry x:Key="IconAddProject">F1 M4,4 A2,2 0 0 1 6,2 H13 V7 A2,2 0 0 0 15,9 H20 V20 A2,2 0 0 1 18,22 H6 A2,2 0 0 1 4,20 Z M14.5,2.5 L19.5,7.5 H15.5 A1,1 0 0 1 14.5,6.5 Z M11,11 H13 V13.5 H15.5 V15.5 H13 V18 H11 V15.5 H8.5 V13.5 H11 Z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M18.93,8 A8,8 0 1 1 12,4 L12,6 A6,6 0 1 0 17.2,9 Z M12,1.5 L16.5,5 L12,8.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconDeploy">M12,2.5 L19.5,10 L18.1,11.4 L13,6.3 V17 H11 V6.3 L5.9,11.4 L4.5,10 Z M4,19.5 H20 V21.5 H4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconStop">F1 M22,12 A10,10 0 1 0 2,12 A10,10 0 1 0 22,12 Z M20.25,12 A8.25,8.25 0 1 1 3.75,12 A8.25,8.25 0 1 1 20.25,12 Z M9.5,8 H14.5 A1.5,1.5 0 0 1 16,9.5 V14.5 A1.5,1.5 0 0 1 14.5,16 H9.5 A1.5,1.5 0 0 1 8,14.5 V9.5 A1.5,1.5 0 0 1 9.5,8 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">F1 M10.13,4.22 L10.36,1.63 L13.64,1.63 L13.87,4.22 A8,8 0 0 1 16.18,5.18 L18.17,3.51 L20.49,5.83 L18.82,7.82 A8,8 0 0 1 19.78,10.13 L22.37,10.36 L22.37,13.64 L19.78,13.87 A8,8 0 0 1 18.82,16.18 L20.49,18.17 L18.17,20.49 L16.18,18.82 A8,8 0 0 1 13.87,19.78 L13.64,22.37 L10.36,22.37 L10.13,19.78 A8,8 0 0 1 7.82,18.82 L5.83,20.49 L3.51,18.17 L5.18,16.18 A8,8 0 0 1 4.22,13.87 L1.63,13.64 L1.63,10.36 L4.22,10.13 A8,8 0 0 1 5.18,7.82 L3.51,5.83 L5.83,3.51 L7.82,5.18 A8,8 0 0 1 10.13,4.22 Z M15.2,12 A3.2,3.2 0 1 0 8.8,12 A3.2,3.2 0 1 0 15.2,12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconKey">F1 M8,7 A5,5 0 1 1 8,17 A5,5 0 1 1 8,7 Z M8,10 A2,2 0 1 0 8,14 A2,2 0 1 0 8,10 Z M12.6,11 H22 V13 H21.5 V16 H19.5 V13 H18.5 V15.5 H16.5 V13 H12.6 Z</StreamGeometry>
        <StreamGeometry x:Key="IconEye">F0 M12,5 C6.5,5 2.5,9.5 1,12 C2.5,14.5 6.5,19 12,19 C17.5,19 21.5,14.5 23,12 C21.5,9.5 17.5,5 12,5 Z M12,7 C16.3,7 19.4,10.3 20.7,12 C19.4,13.7 16.3,17 12,17 C7.7,17 4.6,13.7 3.3,12 C4.6,10.3 7.7,7 12,7 Z M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSummary">F1 M4,4 H20 V6 H4 Z M4,9 H20 V11 H4 Z M4,14 H16 V16 H4 Z M4,19 H12 V21 H4 Z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Shared look for every window. Window-specific styles live in the window. -->

        <!-- Text -->
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.subheading">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.name">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.problem">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#E05561" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(TextBlock).mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Surfaces -->
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="#33808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="#22808080" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pill > TextBlock">
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Dialog footer: a divider, then status/options on the left and buttons on the right -->
        <Style Selector="Border.footer">
            <Setter Property="BorderBrush" Value="#22808080" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,12,0,0" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style Selector="StackPanel.buttons">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="StackPanel.buttons > Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Destructive confirm button -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#C42B3C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D73A4A" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A82333" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Compact inputs -->
        <Style Selector="Button.small">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.small">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.small">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="CheckBox.small">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Main window's top band: menu bar over the slim toolbar -->
        <Style Selector="Border.topbar">
            <Setter Property="Background" Value="#11808080" />
            <Setter Property="BorderBrush" Value="#22808080" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.topbar Menu">
            <Setter Property="Padding" Value="2,0" />
        </Style>
        <Style Selector="Grid.toolbar">
            <Setter Property="Margin" Value="6,0,6,4" />
        </Style>

        <!-- Slim icon toolbar: flat buttons that show their frame on hover; an icon, optionally a label -->
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- Flat buttons stay flat when disabled (Fluent fills them grey) -->
        <Style Selector="Button.tool:not(.accent):disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tool.accent">
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="Button.tool > StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="Button.tool PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.tool TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.toolSeparator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Background" Value="#33808080" />
            <Setter Property="Margin" Value="4,6" />
        </Style>
        <!-- Small icons in menu items -->
        <Style Selector="MenuItem PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>

        <!-- Icon colours (mid tones that read on both the light and the dark theme). The accent
             Deploy button keeps its white icon. Disabled icons fade instead of losing their colour. -->
        <Style Selector="PathIcon.solution">
            <Setter Property="Foreground" Value="#E8A93B" />
        </Style>
        <Style Selector="PathIcon.project">
            <Setter Property="Foreground" Value="#4A9EFF" />
        </Style>
        <Style Selector="PathIcon.refresh">
            <Setter Property="Foreground" Value="#3FB950" />
        </Style>
        <Style Selector="PathIcon.deploy">
            <Setter Property="Foreground" Value="#2888FF" />
        </Style>
        <Style Selector="PathIcon.stop">
            <Setter Property="Foreground" Value="#E05561" />
        </Style>
        <Style Selector="PathIcon.settings">
            <Setter Property="Foreground" Value="#A371F7" />
        </Style>
        <Style Selector="PathIcon.key">
            <Setter Property="Foreground" Value="#E0A044" />
        </Style>
        <Style Selector="PathIcon.eye">
            <Setter Property="Foreground" Value="#39C5CF" />
        </Style>
        <Style Selector="PathIcon.summary">
            <Setter Property="Foreground" Value="#4A9EFF" />
        </Style>
        <Style Selector="Button:disabled PathIcon, MenuItem:disabled PathIcon">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <!-- A toolbar toggle that is off (e.g. Paths hidden): faded icon and label -->
        <Style Selector="Button.tool.off PathIcon">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.tool.off TextBlock">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <!-- Icon-only button on a target row (e.g. the key that opens Credentials) -->
        <Style Selector="Button.rowIcon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rowIcon PathIcon">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
        </Style>
    </Application.Styles>
</Application>
