<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone tool (not part of the solution). Rasterises Assets/app-icon.svg into the
       .ico / .png / .icns the app and installers use. See tools/IconGen/README. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Svg.Skia" Version="3.0.6" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.0" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

</Project>
